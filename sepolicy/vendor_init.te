allow vendor_init tad_block_device:blk_file setattr;
allow vendor_init {
    credmgrd_data_file
    scd_data_file
}:dir create_dir_perms;

# init.qcom.rc: mkdir /data/mediaserver (Sony audio HAL data, used by audioserver, see audioserver.te).
# A core /data type made by vendor init, like the two above: only a neverallow on full Treble devices.
allow vendor_init audioserver_data_file:dir create_dir_perms;

# init.qcom.power.rc: setprop vendor.post_boot.parsed 1
set_prop(vendor_init, vendor_mpctl_prop)
