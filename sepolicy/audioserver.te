# Sony's audio HAL (passthrough, runs in audioserver) keeps its mic gain calibration
# (mic_gain_params_*) in /data/mediaserver, created by init.shinano.mediaserver.rc (system).
allow audioserver audioserver_data_file:dir rw_dir_perms;
allow audioserver audioserver_data_file:file create_file_perms;
