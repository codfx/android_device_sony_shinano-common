diff --git a/libselinux/src/android/android_device.c b/libselinux/src/android/android_device.c
index 9339e8a..dc96da1 100644
--- a/libselinux/src/android/android_device.c
+++ b/libselinux/src/android/android_device.c
@@ -95,7 +95,7 @@ int selinux_android_setcontext(uid_t uid,
 	context_t ctx = NULL;
 	int rc = -1;
 
-	if (is_selinux_enabled() <= 0)
+	if (is_selinux_enabled() <= 0 || security_getenforce() <= 0)
 		return 0;
 
 	rc = getcon(&orig_ctx_str);
@@ -457,8 +457,8 @@ static int selinux_android_restorecon_common(const char* pathname_orig,
